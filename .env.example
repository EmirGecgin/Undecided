SECRET_KEY=degistir-beni
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
DATABASE_URL=postgresql://postgres.[proje-ref]:[parola]@aws-0-[bolge].pooler.supabase.com:6543/postgres

# Parola sıfırlama e-postaları için (boş bırakılırsa yerelde e-posta konsola yazdırılır).
# Prod'da Resend kullanılıyor: EMAIL_BACKEND'i smtp backend'e çevir, EMAIL_HOST_PASSWORD'a
# Resend API anahtarını yaz.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_PASSWORD=re_xxx
# DEFAULT_FROM_EMAIL=Kararsızım <onboarding@resend.dev>
